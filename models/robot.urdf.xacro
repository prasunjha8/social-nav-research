<?xml version="1.0"?>
<robot name="ackermann_chassis" 
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_length" value="0.3"/>
  <xacro:property name="base_width" value="0.15"/>
  <xacro:property name="base_height" value="0.07"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.02"/>
  <xacro:property name="wheel_mass" value="0.1"/>
  <xacro:property name="wheelbase" value="0.257"/>
  <xacro:property name="track_width" value="0.192"/>
  <xacro:property name="base_mass" value="1.5"/>
  <xacro:property name="lidar_radius" value="0.02315"/>
  <xacro:property name="lidar_height" value="0.0348"/>
  <xacro:property name="lidar_mass" value="0.0461"/>


  <!-- ==================== INERTIA MACROS ==================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(1/12)*m*(y*y+z*z)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*m*(x*x+z*z)}"
        iyz="0"
        izz="${(1/12)*m*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(1/12)*m*(3*r*r+h*h)}"
        ixy="0" ixz="0"
        iyy="${(1/12)*m*(3*r*r+h*h)}"
        iyz="0"
        izz="${(1/2)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(2/5)*m*r*r}"
        ixy="0" ixz="0"
        iyy="${(2/5)*m*r*r}"
        iyz="0"
        izz="${(2/5)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== WHEEL MACRO ==================== -->
  <xacro:macro name="wheel" params="name x_offset y_offset">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" 
                              r="${wheel_radius}" 
                              h="${wheel_width}"/>
    </link>

      <gazebo reference="${name}_wheel">
        <mu1 value="0.9"/>
        <mu2 value="0.9"/>
      </gazebo>

    <joint name="${name}_wheel_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x_offset} ${y_offset} -0.035" rpy="-1.5707 0 0"/>
      <limit lower="-1e+16" upper="1e+16" effort="10" velocity="10"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <!-- ==================== BASE LINK ==================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.13 0.014"/>
      </geometry>
      <material name="dark_blue">
        <color rgba="0.08 0.12 0.2 1"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.154 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.17 0.04"/>
      </geometry>
      <material name="bumper">
        <color rgba="0.07 0.08 0.09 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}"
                       x="${base_length}"
                       y="${base_width}"
                       z="${base_height}"/>      
  </link>

  <!--FRONT STEERING JOINTS-->
  <!-- FRONT LEFT -->
  <link name="front_left_steer_link">
    <xacro:box_inertia m="0.05" x="0.01" y="0.01" z="0.01"/>
  </link>

  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer_link"/>
    <origin xyz="0.1285 0.096 -0.035" rpy="0 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
  </link>

  <gazebo reference="front_left_wheel_link">
    <mu1 value="0.9"/>
    <mu2 value="0.9"/>
  </gazebo>

  <joint name="front_left_wheel_joint" type="revolute">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="-1.5707 0 0"/>
    <limit lower="-1e+16" upper="1e+16" effort="10" velocity="10"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- FRONT RIGHT -->
  <link name="front_right_steer_link">
    <xacro:box_inertia m="0.05" x="0.01" y="0.01" z="0.01"/>
  </link> 

  <joint name="front_right_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steer_link"/>
    <origin xyz="0.1285 -0.096 -0.035" rpy="0 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="10" velocity="1.0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
  </link>

  <gazebo reference="front_right_wheel_link">
    <mu1 value="0.9"/>
    <mu2 value="0.9"/>
  </gazebo>

  <joint name="front_right_wheel_joint" type="revolute">
    <parent link="front_right_steer_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="-1.5707 0 0"/>
    <limit lower="-1e+16" upper="1e+16" effort="10" velocity="10"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!--LIDAR LINK-->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" 
                            r="${lidar_radius}" 
                            h="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- On top of base, centered -->
    <origin xyz="-0.035 0 0.155" rpy="0 0 0"/>
  </joint>

  <!--CAMERA LINK-->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.1" x="0.05" y="0.05" z="0.03"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Front of robot, tilted down 30 degrees -->
    <origin xyz="0.175 0 0.04" rpy="0 0.523 0"/>
  </joint>

  <!-- ==================== WHEELS ==================== -->
  <xacro:wheel name="rear_left" x_offset="-0.1285" y_offset="0.096"/>
  <xacro:wheel name="rear_right" x_offset="-0.1285" y_offset="-0.096"/>

  <!-- ==================== GAZEBO PLUGIN ==================== -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>0.192</kingpin_width>
      <steering_limit>0.5</steering_limit>
      <wheel_base>0.257</wheel_base>
      <wheel_separation>0.192</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>/cmd_vel</topic>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>/camera/image_raw</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>